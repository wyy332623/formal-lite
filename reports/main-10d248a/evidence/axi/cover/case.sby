[options]
mode cover
depth 16
timeout 90
cover_assert on

[engines]
smtbmc z3

[script]
read_verilog -formal -sv -DSTABILITY_ONLY -DCOVER_PIPELINED -Irtl -Iformal rtl/axi_bridge.v formal/harness.sv
prep -top bridge_formal

[files]
rtl/axi_bridge.v src/rtl/axi_bridge.v
formal/environment.sv src/formal/environment.sv
formal/properties.sv src/formal/properties.sv
formal/harness.sv src/formal/harness.sv
